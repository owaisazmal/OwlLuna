    "Tie it on from Customise Tools, then pick a line, arrow, circle, rectangle or triangle and drag it out on the page." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über „Werkzeuge anpassen“ hinzufügen, dann eine Linie, einen Pfeil, einen Kreis, ein Rechteck oder ein Dreieck wählen und auf der Seite aufziehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añádelo desde Personalizar herramientas; luego elige una línea, una flecha, un círculo, un rectángulo o un triángulo y arrástralo en la página."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez-le depuis Personnaliser les outils, puis choisissez une ligne, une flèche, un cercle, un rectangle ou un triangle et faites-le glisser sur la page."
          }
        }
