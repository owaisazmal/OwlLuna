    "Recordings" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufnahmen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grabaciones"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrements"
          }
        }
      }
    },
    "Recordings are transcribed on this iPad, in this language unless you pick another for one. Only the languages this iPad can transcribe without sending a recording away are listed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufnahmen werden auf diesem iPad transkribiert, in dieser Sprache, außer du wählst für eine Aufnahme eine andere. Aufgeführt sind nur die Sprachen, die dieses iPad transkribieren kann, ohne eine Aufnahme wegzuschicken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las grabaciones se transcriben en este iPad, en este idioma, salvo que elijas otro para alguna. Solo aparecen los idiomas que este iPad puede transcribir sin enviar la grabación fuera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enregistrements sont transcrits sur cet iPad, dans cette langue, sauf si vous en choisissez une autre pour l’un d’eux. Seules les langues que cet iPad peut transcrire sans envoyer l’enregistrement ailleurs sont proposées."
          }
        }
      }
    },
    "Recordings can't play while another notebook is recording." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufnahmen können nicht abgespielt werden, während ein anderes Notizbuch aufnimmt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las grabaciones no se pueden reproducir mientras otro cuaderno está grabando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enregistrements ne peuvent pas être lus pendant qu’un autre carnet enregistre."
          }
        }
      }
    },
    "Records sound while you write, to play back along with your ink." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimmt Ton auf, während du schreibst, und spielt ihn später zusammen mit deiner Tinte ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba el sonido mientras escribes, para reproducirlo junto con tu tinta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre le son pendant que vous écrivez, pour le réécouter avec votre encre."
          }
        }
      }
    },
    "Recovered %lld pages written just before the app last quit. They're at the end." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
