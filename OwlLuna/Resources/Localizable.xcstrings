          }
        }
      }
    },
    "The version from another device is kept in your library as “%@”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Version vom anderen Gerät ist in deiner Bibliothek als „%@“ gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versión del otro dispositivo se guarda en tu biblioteca como «%@»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version de l’autre appareil est conservée dans votre bibliothèque sous le nom « %@ »."
          }
        }
      }
    },
    "This is the newer version, from another device. Yours is kept in your library as “%@”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist die neuere Version von einem anderen Gerät. Deine ist in deiner Bibliothek als „%@“ gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta es la versión más reciente, de otro dispositivo. La tuya se guarda en tu biblioteca como «%@»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voici la version la plus récente, venue d’un autre appareil. La vôtre est conservée dans votre bibliothèque sous le nom « %@ »."
          }
        }
      }
    },
    "This notebook was changed on another device too. Keep Both keeps the older version as a conflicted copy, as closing it would." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Notizbuch wurde auch auf einem anderen Gerät geändert. „Beide behalten“ sichert die ältere Version als Konfliktkopie, wie es auch beim Schließen geschieht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este cuaderno también se modificó en otro dispositivo. Conservar ambas guarda la versión anterior como copia en conflicto, igual que al cerrarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce carnet a aussi été modifié sur un autre appareil. Conserver les deux enregistre l’ancienne version sous forme de copie en conflit, comme à sa fermeture."
          }
        }
      }
    },
    "Tick" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
