    "Tapping the link opens the address in your browser. Without a name, the link shows the address." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch Tippen auf den Link wird die Adresse in deinem Browser geöffnet. Ohne Namen zeigt der Link die Adresse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al tocar el enlace se abre la dirección en tu navegador. Sin nombre, el enlace muestra la dirección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toucher le lien ouvre l’adresse dans votre navigateur. Sans nom, le lien affiche l’adresse."
          }
        }
      }
    },
    "Tapping the link saves this notebook, puts it away and opens the other one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch Tippen auf den Link wird dieses Notizbuch gesichert und weggelegt und das andere geöffnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
