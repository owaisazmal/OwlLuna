    "Takes back the last thing you did, or does it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimmt das zuletzt Getane zurück oder führt es erneut aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deshace lo último que hiciste, o lo vuelve a hacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annule votre dernière action, ou la refait."
          }
        }
      }
    },
    "Takes whole strokes, or part of one. Tap it again to choose." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt ganze Striche oder einen Teil davon. Zum Auswählen erneut tippen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra trazos enteros o parte de uno. Tócala otra vez para elegir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efface des traits entiers ou une partie d’un trait. Touchez-la à nouveau pour choisir."
          }
        }
      }
    },
    "Tap a line to hear it, with the ink you wrote as it was said." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf eine Zeile, um sie zu hören, zusammen mit der Tinte, die du dabei geschrieben hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una línea para oírla, con la tinta que escribiste mientras se decía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une ligne pour l’écouter, avec l’encre que vous avez écrite à ce moment-là."
          }
        }
      }
    },
    "Tap a pen to write with it. Tap it again to change its kind, colour and width." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf einen Stift, um damit zu schreiben. Tippe erneut, um Art, Farbe und Stärke zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un bolígrafo para escribir con él. Tócalo otra vez para cambiar su tipo, color y grosor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un stylo pour écrire avec. Touchez-le à nouveau pour changer son type, sa couleur et son épaisseur."
          }
        }
      }
    },
    "Tap the microphone to record a lecture or meeting alongside your notes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf das Mikrofon, um eine Vorlesung oder Besprechung parallel zu deinen Notizen aufzunehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el micrófono para grabar una clase o una reunión junto con tus notas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le micro pour enregistrer un cours ou une réunion en même temps que vos notes."
          }
        }
      }
    },
    "Tap the small ribbon beside the page number to bookmark a page. Bookmarks, tagged pages and a PDF's table of contents are listed here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf das kleine Band neben der Seitenzahl, um ein Lesezeichen zu setzen. Lesezeichen, getaggte Seiten und das Inhaltsverzeichnis eines PDFs werden hier aufgelistet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca la cinta pequeña junto al número de página para añadir un marcador. Aquí aparecen los marcadores, las páginas etiquetadas y la tabla de contenido de un PDF."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le petit ruban à côté du numéro de page pour ajouter un signet à une page. Les signets, les pages étiquetées et la table des matières d’un PDF sont répertoriés ici."
          }
        }
      }
    },
