    "Every card has been through your hands today." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute ist jede Karte durch deine Hände gegangen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy has repasado todas las tarjetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les cartes sont passées entre vos mains aujourd'hui."
          }
        }
      }
    },
    "Every notebook and page carrying it takes the new name." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Notizbücher und Seiten, die ihn tragen, erhalten den neuen Namen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los cuadernos y páginas que la llevan toman el nuevo nombre."
