    "Any device that still has them moves them to Recently Deleted, where they stay as long as that device keeps deleted notebooks." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Gerät, auf dem sie noch sind, legt sie in „Zuletzt gelöscht“, wo sie so lange bleiben, wie dieses Gerät gelöschte Notizbücher behält."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier dispositivo que aún los tenga los mueve a Eliminados recientemente, donde se conservan el tiempo que ese dispositivo guarde los cuadernos eliminados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout appareil qui les a encore les déplace vers Supprimés récemment, où ils restent aussi longtemps que cet appareil garde les carnets supprimés."
          }
        }
      }
    },
