    "Write in any direction. Drag with two fingers to move, and pinch to zoom." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib in jede Richtung. Mit zwei Fingern ziehen bewegt die Seite, Auf- und Zuziehen zoomt."
