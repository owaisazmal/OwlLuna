          }
        }
      }
    },
    "The week strip and calendar start afresh. Your notebooks and pages aren't affected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wochenleiste und Kalender beginnen von vorn. Deine Notizbücher und Seiten sind nicht betroffen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tira semanal y el calendario empiezan de cero. Tus cuadernos y páginas no se ven afectados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bande de la semaine et le calendrier repartent de zéro. Vos carnets et vos pages ne sont pas modifiés."
          }
        }
      }
    },
