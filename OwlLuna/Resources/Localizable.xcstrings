    "Study Guide" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lernhilfe"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guía de estudio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guide d'étude"
          }
        }
      }
    },
    "Study guides are written by Apple Intelligence on the iPad itself, and this iPad doesn't have it. OwlLuna never sends your notes anywhere to be read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lernhilfen werden von Apple Intelligence auf dem iPad selbst geschrieben, und dieses iPad hat es nicht. OwlLuna sendet deine Notizen nie irgendwohin, um sie zu lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las guías de estudio las escribe Apple Intelligence en el propio iPad, y este iPad no lo tiene. OwlLuna nunca envía tus notas a ningún sitio para leerlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les guides d'étude sont rédigés par Apple Intelligence sur l'iPad lui-même, et cet iPad n'en dispose pas. OwlLuna n'envoie jamais vos notes ailleurs pour les lire."
          }
        }
      }
    },
    "Study guides are written by Apple Intelligence on the iPad itself, which needs iPadOS 26 or later. Your notes never leave it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lernhilfen werden von Apple Intelligence auf dem iPad selbst geschrieben, wofür iPadOS 26 oder neuer nötig ist. Deine Notizen verlassen es nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las guías de estudio las escribe Apple Intelligence en el propio iPad, que necesita iPadOS 26 o posterior. Tus notas nunca salen de él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les guides d'étude sont rédigés par Apple Intelligence sur l'iPad lui-même, ce qui nécessite iPadOS 26 ou ultérieur. Vos notes ne le quittent jamais."
          }
        }
      }
    },
    "Study guides are written by Apple Intelligence on the iPad itself. Turn it on in Settings, under Apple Intelligence and Siri, and come back. Your notes never leave the iPad." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lernhilfen werden von Apple Intelligence auf dem iPad selbst geschrieben. Schalte es in den Einstellungen unter „Apple Intelligence & Siri“ ein und komm zurück. Deine Notizen verlassen das iPad nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las guías de estudio las escribe Apple Intelligence en el propio iPad. Actívalo en Ajustes, en Apple Intelligence y Siri, y vuelve. Tus notas nunca salen del iPad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les guides d'étude sont rédigés par Apple Intelligence sur l'iPad lui-même. Activez-le dans Réglages, sous Apple Intelligence et Siri, puis revenez. Vos notes ne quittent jamais l'iPad."
          }
        }
      }
    },
