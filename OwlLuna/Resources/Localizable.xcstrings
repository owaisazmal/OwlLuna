          "stringUnit" : {
            "state" : "translated",
            "value" : "Figuras ocultas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formes masquées"
          }
        }
      }
    },
    "Shapes: %@. Drag on the page to draw it." : {
