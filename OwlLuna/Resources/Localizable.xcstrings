    "Drag to choose the part of the page the zoom window shows. Swipe up or down to move it along the line." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe, um den Teil der Seite zu wählen, den das Zoomfenster zeigt. Streiche nach oben oder unten, um es entlang der Zeile zu bewegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
