    "Every page of the notebook. Among them a whiteboard is a card: tap the card to open it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Seiten des Notizbuchs. Dazwischen ist ein Whiteboard eine Karte: Tippe auf die Karte, um es wieder zu öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las páginas del cuaderno. Entre ellas, una pizarra es una tarjeta: toca la tarjeta para abrirla de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
