          }
        }
      }
    },
    "iCloud Drive didn't let OwlLuna reach its files: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive hat OwlLuna nicht an seine Dateien gelassen: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive no dejó que OwlLuna accediera a sus archivos: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive n’a pas laissé OwlLuna accéder à ses fichiers : %@"
          }
        }
      }
    },
    "iCloud can't be reached right now. Changes made on this iPad will upload when it's back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ist gerade nicht erreichbar. Änderungen auf diesem iPad werden hochgeladen, sobald es wieder erreichbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede conectar con iCloud ahora. Los cambios hechos en este iPad se subirán cuando vuelva a estar disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud est injoignable pour le moment. Les modifications faites sur cet iPad seront envoyées dès son retour."
          }
        }
      }
    },
    "iCloud couldn't upload some files: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud konnte einige Dateien nicht hochladen: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud no pudo subir algunos archivos: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud n’a pas pu envoyer certains fichiers : %@"
          }
        }
      }
    },
    "iCloud is still downloading your library. Sync will try again shortly." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud lädt deine Bibliothek noch. Die Synchronisierung wird gleich erneut versucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud aún está descargando tu biblioteca. La sincronización se volverá a intentar en breve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud télécharge encore votre bibliothèque. La synchronisation réessaiera sous peu."
          }
        }
      }
    },
    "iCloud isn't available. Sign in to iCloud and turn on iCloud Drive in Settings; this copy of OwlLuna also has to be built with the iCloud capability." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ist nicht verfügbar. Melde dich bei iCloud an und aktiviere iCloud Drive in den Einstellungen. Außerdem muss diese Kopie von OwlLuna mit der iCloud-Funktion erstellt sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud no está disponible. Inicia sesión en iCloud y activa iCloud Drive en Ajustes; además, esta copia de OwlLuna debe estar compilada con la capacidad de iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud n’est pas disponible. Connectez-vous à iCloud et activez iCloud Drive dans Réglages ; cette copie d’OwlLuna doit aussi être compilée avec la fonctionnalité iCloud."
          }
        }
      }
    },
