    "Shapes draws a line, arrow, circle, rectangle or triangle where you drag. Or draw one by hand and rest the pen a moment before lifting to straighten it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formen zeichnet eine Linie, einen Pfeil, einen Kreis, ein Rechteck oder ein Dreieck, wo du ziehst. Oder zeichne eine Form von Hand und halte den Stift vor dem Abheben kurz still, um sie zu begradigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Figuras dibuja una línea, una flecha, un círculo, un rectángulo o un triángulo donde arrastres. O dibuja una a mano y mantén el lápiz quieto un momento antes de levantarlo para enderezarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formes trace une ligne, une flèche, un cercle, un rectangle ou un triangle là où vous faites glisser. Ou tracez-en une à la main et restez immobile un instant avant de lever le crayon pour la redresser."
          }
        }
      }
    },
    "Shapes put away" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formen ausgeblendet"
