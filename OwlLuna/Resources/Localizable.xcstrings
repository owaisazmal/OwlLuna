    "Cover" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einband"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cubierta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couverture"
          }
        }
      }
    },
    "Cover an answer with study tape and make a card from the strip, select handwriting and turn it into one, or write a card yourself. Each comes back when it is time to see it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decke eine Antwort mit Lernklebeband ab und mache aus dem Streifen eine Karte, wähle Handschrift aus und verwandle sie in eine, oder schreibe selbst eine Karte. Jede kommt zurück, wenn es Zeit ist, sie wiederzusehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapa una respuesta con cinta de estudio y crea una tarjeta a partir de la tira, selecciona escritura y conviértela en una, o escribe una tarjeta tú mismo. Cada una vuelve cuando toca verla de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couvrez une réponse avec du ruban de révision et créez une carte à partir de la bande, sélectionnez de l'écriture pour en faire une, ou écrivez une carte vous-même. Chacune revient quand il est temps de la revoir."
          }
        }
      }
    },
