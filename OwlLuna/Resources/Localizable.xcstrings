    "Written on this iPad from what your notes say. Nothing was sent anywhere. Check it against your notes: it can be wrong." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem iPad aus dem geschrieben, was in deinen Notizen steht. Nichts wurde irgendwohin gesendet. Vergleiche es mit deinen Notizen: Es kann falsch sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escrito en este iPad a partir de lo que dicen tus notas. No se envió nada a ningún sitio. Compáralo con tus notas: puede equivocarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rédigé sur cet iPad à partir de ce que disent vos notes. Rien n'a été envoyé ailleurs. Vérifiez avec vos notes : il peut se tromper."
          }
        }
