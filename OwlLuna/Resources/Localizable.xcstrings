      }
    },
    "The backup had nothing in it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Backup war leer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia de seguridad estaba vacía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sauvegarde était vide."
          }
        }
      }
    },
    "The card couldn't be saved" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karte konnte nicht gesichert werden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar la tarjeta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte n'a pas pu être enregistrée"
          }
        }
      }
    },
    "The file couldn't be read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei konnte nicht gelesen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer el archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier n’a pas pu être lu."
          }
        }
      }
    },
    "The file doesn't contain any pages." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei enthält keine Seiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo no contiene ninguna página."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier ne contient aucune page."
          }
        }
      }
    },
    "The handwriting recogniser didn't answer. Try again in a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Handschrifterkennung hat nicht geantwortet. Versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reconocedor de escritura no respondió. Inténtalo de nuevo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reconnaissance d’écriture n’a pas répondu. Réessayez dans un instant."
          }
        }
      }
    },
    "The ink on a page couldn't be read. The original file was kept as %@, and the page starts empty." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Tinte auf einer Seite konnte nicht gelesen werden. Die Originaldatei wurde als %@ aufbewahrt, und die Seite beginnt leer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer la tinta de una página. El archivo original se conservó como %@ y la página empieza vacía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’encre d’une page n’a pas pu être lue. Le fichier d’origine a été conservé sous le nom %@, et la page repart vide."
          }
        }
      }
    },
    "The ink on page %lld couldn't be read. The original file was kept as %@, and the page starts empty." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Tinte auf Seite %1$lld konnte nicht gelesen werden. Die Originaldatei wurde als %2$@ aufbewahrt, und die Seite beginnt leer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The ink on page %1$lld couldn't be read. The original file was kept as %2$@, and the page starts empty."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer la tinta de la página %1$lld. El archivo original se conservó como %2$@ y la página empieza vacía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’encre de la page %1$lld n’a pas pu être lue. Le fichier d’origine a été conservé sous le nom %2$@, et la page repart vide."
          }
        }
      }
    },
    "The journal couldn't be created" : {
