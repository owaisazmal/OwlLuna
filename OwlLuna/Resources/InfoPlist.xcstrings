{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleDisplayName" : {
      "comment" : "Bundle display name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OwlLuna"
          }
        }
      }
    },
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OwlLuna"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OwlLuna liest die heutigen Termine, um sie auf eine Seite zu drucken, wenn du darum bittest. Sie werden auf diesem iPad gelesen und gehören nach dem Drucken zum Notizbuch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OwlLuna reads today's events to print them on a page when you ask it to. They are read on this iPad, and once printed they are part of the notebook."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OwlLuna lee los eventos de hoy para imprimirlos en una página cuando se lo pides. Se leen en este iPad y, una vez impresos, forman parte del cuaderno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OwlLuna lit les événements du jour pour les imprimer sur une page lorsque vous le demandez. Ils sont lus sur cet iPad et, une fois imprimés, font partie du carnet."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OwlLuna verwendet die Kamera, um Papier zu scannen und Fotos für deine Notizbücher aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OwlLuna uses the camera to scan paper and take photos for your notebooks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OwlLuna usa la cámara para escanear papel y hacer fotos para tus cuadernos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OwlLuna utilise l’appareil photo pour numériser du papier et prendre des photos pour vos carnets."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OwlLuna verwendet Face ID, um die Notizbücher zu öffnen, die du gesperrt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OwlLuna uses Face ID to open the notebooks you have locked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OwlLuna usa Face ID para abrir los cuadernos que has bloqueado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OwlLuna utilise Face ID pour ouvrir les carnets que vous avez verrouillés."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OwlLuna nimmt Audio parallel zu deinen Notizen auf, wenn du auf die Aufnahmetaste tippst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OwlLuna records audio alongside your notes when you tap the record button."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OwlLuna graba audio junto con tus notas cuando tocas el botón de grabar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OwlLuna enregistre l’audio en même temps que vos notes lorsque vous touchez le bouton d’enregistrement."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OwlLuna sichert die von dir exportierten Bilder und Videos in deiner Fotomediathek, wenn du das auswählst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OwlLuna saves the pictures and videos you export to your photo library when you choose to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OwlLuna guarda en tu fototeca las imágenes y los vídeos que exportas cuando tú lo eliges."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OwlLuna enregistre dans votre photothèque les images et les vidéos que vous exportez lorsque vous le choisissez."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OwlLuna fügt von dir ausgewählte Fotos als Seiten oder Bilder in deine Notizbücher ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OwlLuna adds photos you pick as pages or pictures in your notebooks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OwlLuna añade las fotos que eliges como páginas o imágenes en tus cuadernos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OwlLuna ajoute les photos que vous choisissez comme pages ou images dans vos carnets."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OwlLuna schreibt auf, was in einer Aufnahme gesagt wurde, wenn du darum bittest. Die Aufnahme wird auf diesem iPad transkribiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OwlLuna writes down what was said in a recording when you ask it to. The recording is transcribed on this iPad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OwlLuna pone por escrito lo que se dijo en una grabación cuando se lo pides. La grabación se transcribe en este iPad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OwlLuna met par écrit ce qui a été dit dans un enregistrement lorsque vous le demandez. L’enregistrement est transcrit sur cet iPad."
          }
        }
      }
    },
